# ==============================================================================
# Reliable Assurance Backend - Environment Configuration Template
# ==============================================================================
# NOTE: The legacy production database (brahmainsurance) must NEVER be used as the
# runtime database. All runtime operations use the independent local development database.
# ==============================================================================

# Application Environment
APP_NAME="Reliable Assurance Backend"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
APP_HOST="0.0.0.0"
APP_PORT=8000

# Local MySQL Database Configuration (Independent development database)
# Format: mysql+aiomysql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL="mysql+aiomysql://root:password@localhost:3306/reliable_insurance_dev"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=3600
DB_ECHO=false

# Local Redis Configuration
REDIS_URL="redis://localhost:6379/0"
REDIS_CONNECT_TIMEOUT=5

# Security & Authentication (JWT)
# Generate a secure key in production: openssl rand -hex 32
JWT_SECRET_KEY="insecure-placeholder-change-in-production-must-be-at-least-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (JSON array or comma-separated strings)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]
